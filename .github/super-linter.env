# Configuração do super-linter, a mesma no CI (lint.yml) e em casa (ver CONTRIBUTING.md)
VALIDATE_ALL_CODEBASE=false
VALIDATE_BASH=true
BASH_SEVERITY=error
VALIDATE_DOCKERFILE_HADOLINT=true
VALIDATE_GITHUB_ACTIONS=true
VALIDATE_MARKDOWN=true
VALIDATE_YAML=true
# o código do MOJ (submódulos) segue o padrão dos autores, e o problema do teste segue o formato
# de pacote do MOJ (o enunciado começa sem título)
FILTER_REGEX_EXCLUDE=(^|/)(vendor|tests/e2e/problema)/.*
